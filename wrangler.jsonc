// Configuração do Cloudflare Workers.
// Publica a pasta public/ como site estático; o src/worker.js roda na página inicial (escolhe o idioma)
// nas rotas /api/ (alunos, painel, compras) e nas páginas /cursos/, /blog/ e /imagens/ (geradas a partir do banco).
{
  "name": "site-carlos-henrique",
  "main": "src/worker.js",
  "compatibility_date": "2026-10-01",
  "assets": {
    "directory": "./public",
    "binding": "ASSETS",
    "not_found_handling": "404-page",
    "run_worker_first": ["/", "/index.html", "/api/*", "/cursos", "/cursos/*", "/blog", "/blog/*", "/imagens/*", "/declaracao/formulario", "/declaracao/formulario/"]
  },
  // Banco de dados dos alunos. Sem "database_id": o Cloudflare cria o banco sozinho na primeira publicação.
  // As tabelas são criadas pelo próprio Worker na primeira requisição (src/alunos.js).
  "d1_databases": [{ "binding": "DB", "database_name": "carlos-henrique-alunos" }],
  // Endereço de teste site-carlos-henrique.<conta>.workers.dev
  "workers_dev": true
}
